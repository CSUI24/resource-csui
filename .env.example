# Supabase runtime URL. Prefer the Supabase transaction/session pooler for app traffic.
# Example pooler shape:
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
DATABASE_URL=""

# Supabase direct URL for Prisma migrations/introspection. Do not use the pooler here.
# Use the direct connection string from Supabase Project Settings > Database.
# Example direct shape:
# DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL=""
DATABASE_POOL_MAX="10"

APP_BASE_URL="http://localhost:3000"
SSO_BASE_URL="https://sso.ui.ac.id/cas2"
SSO_CALLBACK_URL="http://localhost:3000/api/auth/sso/callback"
ENABLE_DEV_AUTH="true"

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
