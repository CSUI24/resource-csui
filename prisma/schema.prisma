generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UploadStatus {
  PENDING
  READY
  FAILED
}

model User {
  id                 String         @id @default(cuid())
  username           String         @unique
  name               String
  email              String?        @unique
  npm                String?
  organizationalCode String?
  avatarUrl          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  sessions           Session[]
  folders            Folder[]
  files              ResourceFile[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Folder {
  id        String         @id @default(cuid())
  name      String
  parentId  String?
  ownerId   String
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  parent    Folder?        @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]       @relation("FolderTree")
  owner     User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  files     ResourceFile[]

  @@index([ownerId, parentId])
  @@index([ownerId, parentId, name])
  @@index([parentId, name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Folder_name_trgm_idx")
}

model ResourceFile {
  id           String       @id @default(cuid())
  name         String
  folderId     String
  ownerId      String
  mimeType     String
  sizeBytes    Int
  storageKey   String       @unique
  storageUrl   String
  uploadStatus UploadStatus @default(PENDING)
  metadata     Json         @default("{}")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  folder       Folder       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([ownerId])
  @@index([ownerId, folderId, uploadStatus, name])
  @@index([ownerId, uploadStatus, updatedAt])
  @@index([folderId, uploadStatus, name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "ResourceFile_name_trgm_idx")
  @@index([metadata(ops: JsonbPathOps)], type: Gin, map: "ResourceFile_metadata_gin_idx")
}
